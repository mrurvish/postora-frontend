# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Google OAuth (if implementing Google auth)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Optional: Analytics (if implementing analytics)
NEXT_PUBLIC_GA_TRACKING_ID=your_ga_tracking_id

# Optional: Feature Flags (if implementing feature flags)
NEXT_PUBLIC_ENABLE_COMMENTS=true
NEXT_PUBLIC_ENABLE_BOOKMARKS=true
NEXT_PUBLIC_ENABLE_SHARING=true
